{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=TodoAppDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "TodoApp",
    "Audience": "TodoAppClient",
    // Development-only key. Store it in a secret manager / env variable in production.
    "Key": "dev-only-todoapp-super-secret-key-0123456789abcdef-CHANGE-ME",
    "ExpiryMinutes": 1440
  },
  "PasswordHasher": {
    "Iterations": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
